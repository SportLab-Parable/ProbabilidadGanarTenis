: 0.5056, \"2-1\": 0.2762, \"1-2\": 0.1272, \"0-2\": 0.091}}, {\"deporte\": \"badminton\", \"delta\": 0.0, \"p\": 0.55, \"victorias\": 0.8308, \"marcadores\": {\"2-0\": 0.5448, \"2-1\": 0.286, \"1-2\": 0.1004, \"0-2\": 0.0688}}, {\"deporte\": \"badminton\", \"delta\": 0.0, \"p\": 0.56, \"victorias\": 0.869, \"marcadores\": {\"2-0\": 0.6106, \"2-1\": 0.2584, \"1-2\": 0.0794, \"0-2\": 0.0516}}, {\"deporte\": \"badminton\", \"delta\": 0.0, \"p\": 0.57, \"victorias\": 0.9154, \"marcadores\": {\"2-0\": 0.6744, \"2-1\": 0.241, \"1-2\": 0.051, \"0-2\": 0.0336}}, {\"deporte\": \"badminton\", \"delta\": 0.0, \"p\": 0.58, \"victorias\": 0.9416, \"marcadores\": {\"2-0\": 0.7396, \"2-1\": 0.202, \"1-2\": 0.0356, \"0-2\": 0.0228}}, {\"deporte\": \"badminton\", \"delta\": 0.0, \"p\": 0.59, \"victorias\": 0.9624, \"marcadores\": {\"2-0\": 0.7872, \"2-1\": 0.1752, \"1-2\": 0.0232, \"0-2\": 0.0144}}, {\"deporte\": \"badminton\", \"delta\": 0.0, \"p\": 0.6, \"victorias\": 0.9724, \"marcadores\": {\"2-0\": 0.8272, \"2-1\": 0.1452, \"1-2\": 0.0188, \"0-2\": 0.0088}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.4, \"victorias\": 0.0328, \"marcadores\": {\"3-0\": 0.0036, \"3-1\": 0.0096, \"3-2\": 0.0196, \"2-3\": 0.092, \"1-3\": 0.2832, \"0-3\": 0.592}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.41, \"victorias\": 0.0452, \"marcadores\": {\"3-0\": 0.0072, \"3-1\": 0.015, \"3-2\": 0.023, \"2-3\": 0.1202, \"1-3\": 0.3004, \"0-3\": 0.5342}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.42, \"victorias\": 0.0724, \"marcadores\": {\"3-0\": 0.009, \"3-1\": 0.0242, \"3-2\": 0.0392, \"2-3\": 0.1308, \"1-3\": 0.3206, \"0-3\": 0.4762}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.43, \"victorias\": 0.1118, \"marcadores\": {\"3-0\": 0.0148, \"3-1\": 0.0386, \"3-2\": 0.0584, \"2-3\": 0.1516, \"1-3\": 0.3226, \"0-3\": 0.414}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.44, \"victorias\": 0.1356, \"marcadores\": {\"3-0\": 0.0202, \"3-1\": 0.0474, \"3-2\": 0.068, \"2-3\": 0.1754, \"1-3\": 0.3064, \"0-3\": 0.3826}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.45, \"victorias\": 0.1888, \"marcadores\": {\"3-0\": 0.0322, \"3-1\": 0.0696, \"3-2\": 0.087, \"2-3\": 0.1878, \"1-3\": 0.3032, \"0-3\": 0.3202}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.46, \"victorias\": 0.2384, \"marcadores\": {\"3-0\": 0.0408, \"3-1\": 0.0896, \"3-2\": 0.108, \"2-3\": 0.2052, \"1-3\": 0.2842, \"0-3\": 0.2722}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.47, \"victorias\": 0.2898, \"marcadores\": {\"3-0\": 0.0558, \"3-1\": 0.1054, \"3-2\": 0.1286, \"2-3\": 0.2142, \"1-3\": 0.2698, \"0-3\": 0.2262}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.48, \"victorias\": 0.3664, \"marcadores\": {\"3-0\": 0.0782, \"3-1\": 0.1306, \"3-2\": 0.1576, \"2-3\": 0.2054, \"1-3\": 0.2474, \"0-3\": 0.1808}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.49, \"victorias\": 0.4316, \"marcadores\": {\"3-0\": 0.1026, \"3-1\": 0.1608, \"3-2\": 0.1682, \"2-3\": 0.1992, \"1-3\": 0.2176, \"0-3\": 0.1516}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.5, \"victorias\": 0.4984, \"marcadores\": {\"3-0\": 0.1208, \"3-1\": 0.1846, \"3-2\": 0.193, \"2-3\": 0.1864, \"1-3\": 0.194, \"0-3\": 0.1212}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.51, \"victorias\": 0.5712, \"marcadores\": {\"3-0\": 0.157, \"3-1\": 0.2212, \"3-2\": 0.193, \"2-3\": 0.1698, \"1-3\": 0.163, \"0-3\": 0.096}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.52, \"victorias\": 0.6474, \"marcadores\": {\"3-0\": 0.2002, \"3-1\": 0.2352, \"3-2\": 0.212, \"2-3\": 0.15, \"1-3\": 0.1294, \"0-3\": 0.0732}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.53, \"victorias\": 0.6982, \"marcadores\": {\"3-0\": 0.2332, \"3-1\": 0.2664, \"3-2\": 0.1986, \"2-3\": 0.1366, \"1-3\": 0.1098, \"0-3\": 0.0554}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.54, \"victorias\": 0.7704, \"marcadores\": {\"3-0\": 0.276, \"3-1\": 0.2998, \"3-2\": 0.1946, \"2-3\": 0.1024, \"1-3\": 0.089, \"0-3\": 0.0382}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.55, \"victorias\": 0.8058, \"marcadores\": {\"3-0\": 0.324, \"3-1\": 0.2958, \"3-2\": 0.186, \"2-3\": 0.0982, \"1-3\": 0.0652, \"0-3\": 0.0308}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.56, \"victorias\": 0.865, \"marcadores\": {\"3-0\": 0.3744, \"3-1\": 0.3092, \"3-2\": 0.1814, \"2-3\": 0.0666, \"1-3\": 0.0458, \"0-3\": 0.0226}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.57, \"victorias\": 0.9024, \"marcadores\": {\"3-0\": 0.414, \"3-1\": 0.3204, \"3-2\": 0.168, \"2-3\": 0.0524, \"1-3\": 0.0322, \"0-3\": 0.013}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.58, \"victorias\": 0.9282, \"marcadores\": {\"3-0\": 0.478, \"3-1\": 0.3262, \"3-2\": 0.124, \"2-3\": 0.0404, \"1-3\": 0.022, \"0-3\": 0.0094}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.59, \"victorias\": 0.9478, \"marcadores\": {\"3-0\": 0.5288, \"3-1\": 0.3072, \"3-2\": 0.1118, \"2-3\": 0.03, \"1-3\": 0.016, \"0-3\": 0.0062}}, {\"deporte\": \"pingpong\", \"delta\": 0.0, \"p\": 0.6, \"victorias\": 0.9664, \"marcadores\": {\"3-0\": 0.5796, \"3-1\": 0.292, \"3-2\": 0.0948, \"2-3\": 0.017, \"1-3\": 0.0134, \"0-3\": 0.0032}}];                       // Resultados calculados por Python\n",
       "  const el = id => document.getElementById(id);\n",
       "\n",
       "  // Medidas de la gráfica y conversión de valores a posiciones en pantalla\n",
       "  const W = 700, H = 420, mL = 60, mR = 20, mT = 20, mB = 50;\n",
       "  const X = p => mL + (p - 0.40) / 0.20 * (W - mL - mR);\n",
       "  const Y = v => H - mB - v * (H - mT - mB);\n",
       "\n",
       "  function dibujar() {\n",
       "    const deporte = el(\"deporte\").value;\n",
       "    const p = parseFloat(el(\"p\").value);\n",
       "    const delta = deporte === \"tenis\" ? parseFloat(el(\"delta\").value) : 0;\n",
       "\n",
       "    el(\"p_val\").textContent = p.toFixed(2);\n",
       "    el(\"delta_val\").textContent = (delta >= 0 ? \"+\" : \"\") + delta.toFixed(2);\n",
       "    el(\"delta\").disabled = deporte !== \"tenis\";\n",
       "\n",
       "    // Nos quedamos con los datos del deporte y la ventaja elegidos\n",
       "    const curva = datos.filter(d => d.deporte === deporte && Math.abs(d.delta - delta) < 0.005);\n",
       "    const actual = curva.find(d => Math.abs(d.p - p) < 0.005);\n",
       "\n",
       "    el(\"texto\").innerHTML = \"Con <b>p = \" + p.toFixed(2) + \"</b>, el jugador A gana el <b>\" +\n",
       "      (actual.victorias * 100).toFixed(1) + \" %</b> de los partidos.\";\n",
       "\n",
       "    let s = \"\";\n",
       "\n",
       "    // Cuadrícula horizontal y números del eje y\n",
       "    for (let v = 0; v <= 1.0001; v += 0.2) {\n",
       "      s += '<line x1=\"' + mL + '\" x2=\"' + (W - mR) + '\" y1=\"' + Y(v) + '\" y2=\"' + Y(v) +\n",
       "           '\" stroke=\"#999\" stroke-opacity=\"0.3\"/>';\n",
       "      s += '<text x=\"' + (mL - 8) + '\" y=\"' + (Y(v) + 4) +\n",
       "           '\" text-anchor=\"end\" font-size=\"12\" fill=\"currentColor\">' + v.toFixed(1) + '</text>';\n",
       "    }\n",
       "    // Números del eje x\n",
       "    for (let i = 0; i <= 4; i++) {\n",
       "      const x = 0.40 + 0.05 * i;\n",
       "      s += '<text x=\"' + X(x) + '\" y=\"' + (H - mB + 20) +\n",
       "           '\" text-anchor=\"middle\" font-size=\"12\" fill=\"currentColor\">' + x.toFixed(2) + '</text>';\n",
       "    }\n",
       "    // Títulos de los ejes\n",
       "    s += '<text x=\"' + (mL + (W - mL - mR) / 2) + '\" y=\"' + (H - 8) +\n",
       "         '\" text-anchor=\"middle\" font-size=\"13\" fill=\"currentColor\">Probabilidad de ganar un punto (p)</text>';\n",
       "    s += '<text transform=\"rotate(-90)\" x=\"' + (-(mT + (H - mT - mB) / 2)) + '\" y=\"16\" ' +\n",
       "         'text-anchor=\"middle\" font-size=\"13\" fill=\"currentColor\">Probabilidad de ganar el partido</text>';\n",
       "\n",
       "    // Línea de referencia: un partido a un solo punto (victorias = p)\n",
       "    s += '<line x1=\"' + X(0.40) + '\" y1=\"' + Y(0.40) + '\" x2=\"' + X(0.60) + '\" y2=\"' + Y(0.60) +\n",
       "         '\" stroke=\"gray\" stroke-dasharray=\"5\"/>';\n",
       "\n",
       "    // La curva y sus puntos\n",
       "    const puntos = curva.map(d => X(d.p) + \",\" + Y(d.victorias)).join(\" \");\n",
       "    s += '<polyline points=\"' + puntos + '\" fill=\"none\" stroke=\"steelblue\" stroke-width=\"2\"/>';\n",
       "    curva.forEach(d => {\n",
       "      s += '<circle cx=\"' + X(d.p) + '\" cy=\"' + Y(d.victorias) + '\" r=\"3\" fill=\"steelblue\"/>';\n",
       "    });\n",
       "\n",
       "    // El punto elegido, en rojo\n",
       "    s += '<circle cx=\"' + X(actual.p) + '\" cy=\"' + Y(actual.victorias) + '\" r=\"8\" fill=\"red\"/>';\n",
       "\n",
       "    el(\"grafica\").innerHTML = s;\n",
       "\n",
       "    // Marcadores: una barra por cada resultado (azul = gana A, rojo = gana B)\n",
       "    const maximo = Math.max(...Object.values(actual.marcadores)) || 1;\n",
       "    let barras = \"\";\n",
       "    Object.entries(actual.marcadores).forEach(([marcador, fraccion]) => {\n",
       "      const sets = marcador.split(\"-\").map(Number);\n",
       "      const color = sets[0] > sets[1] ? \"steelblue\" : \"tomato\";\n",
       "      barras += '<div style=\"display:flex; align-items:center; gap:10px; margin:3px 0\">' +\n",
       "        '<span style=\"width:40px\"><b>' + marcador + '</b></span>' +\n",
       "        '<div style=\"flex:1; max-width:400px\">' +\n",
       "          '<div style=\"background:' + color + '; height:16px; width:' + (fraccion / maximo * 100) + '%\"></div>' +\n",
       "        '</div>' +\n",
       "        '<span style=\"width:60px; text-align:right\">' + (fraccion * 100).toFixed(1) + ' %</span>' +\n",
       "      '</div>';\n",
       "    });\n",
       "    el(\"marcadores\").innerHTML = barras;\n",
       "  }\n",
       "\n",
       "  // Cada vez que el usuario toca un control, se vuelve a dibujar\n",
       "  [\"deporte\", \"p\", \"delta\"].forEach(id => el(id).addEventListener(\"input\", dibujar));\n",
       "  dibujar();\n",
       "})();\n",
       "</script>\n"
      ],
      "text/plain": [
       "<IPython.core.display.HTML object>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Python simula los partidos solo una vez, al generar el documento.\n",
    "# Los resultados se guardan dentro del HTML para que el navegador los use.\n",
    "import json\n",
    "import random\n",
    "\n",
    "from IPython.display import HTML, display\n",
    "\n",
    "from simulador_partidos import simular\n",
    "\n",
    "N_PARTIDOS = 5000    # Partidos simulados por cada combinación.\n",
    "\n",
    "valores_p = [round(0.40 + 0.01 * i, 2) for i in range(21)]        # 0.40, 0.41, ... 0.60\n",
    "valores_delta = [round(-0.05 + 0.01 * i, 2) for i in range(11)]   # -0.05, ..., 0.05\n",
    "\n",
    "random.seed(42)\n",
    "filas = []\n",
    "\n",
    "for deporte in ['tenis', 'badminton', 'pingpong']:\n",
    "    # La ventaja de presión solo existe en tenis; en los demás deportes es 0\n",
    "    deltas = valores_delta if deporte == 'tenis' else [0.0]\n",
    "    for delta in deltas:\n",
    "        for p in valores_p:\n",
    "            resultado = simular(deporte, p, p + delta, N_PARTIDOS)\n",
    "            filas.append({\n",
    "                'deporte': deporte,\n",
    "                'delta': delta,\n",
    "                'p': p,\n",
    "                'victorias': resultado['prob_ganar_partido'],\n",
    "                'marcadores': resultado['marcadores'],   # Ej.: {'3-0': 0.25, '3-1': 0.28, ...}\n",
    "            })\n",
    "\n",
    "# Controles y gráficos de la página. \n",
    "# El navegador la dibuja con JavaScript usando los resultados de arriba.\n",
    "PLANTILLA = \"\"\"\n",
    "<div id=\"sim\">\n",
    "  <p><label>Deporte:\n",
    "    <select id=\"deporte\">\n",
    "      <option value=\"tenis\">Tenis</option>\n",
    "      <option value=\"badminton\">Bádminton</option>\n",
    "      <option value=\"pingpong\">Ping-pong</option>\n",
    "    </select></label></p>\n",
    "  <p><label>Probabilidad de ganar un punto (p):\n",
    "    <input type=\"range\" id=\"p\" min=\"0.40\" max=\"0.60\" step=\"0.01\" value=\"0.52\">\n",
    "    <b id=\"p_val\"></b></label></p>\n",
    "  <p><label>Ventaja en puntos de presión (solo tenis):\n",
    "    <input type=\"range\" id=\"delta\" min=\"-0.05\" max=\"0.05\" step=\"0.01\" value=\"0\">\n",
    "    <b id=\"delta_val\"></b></label></p>\n",
    "  <p id=\"texto\" style=\"font-size:1.1em\"></p>\n",
    "  <svg id=\"grafica\" viewBox=\"0 0 700 420\" style=\"max-width:700px; width:100%; color:inherit\"></svg>\n",
    "  <h4>Probabilidad de cada marcador final (sets de A - sets de B)</h4>\n",
    "  <div id=\"marcadores\"></div>\n",
    "</div>\n",
    "\n",
    "<script>\n",
    "(function () {\n",
    "  const datos = __DATOS__;                       // Resultados calculados por Python\n",
    "  const el = id => document.getElementById(id);\n",
    "\n",
    "  // Medidas de la gráfica y conversión de valores a posiciones en pantalla\n",
    "  const W = 700, H = 420, mL = 60, mR = 20, mT = 20, mB = 50;\n",
    "  const X = p => mL + (p - 0.40) / 0.20 * (W - mL - mR);\n",
    "  const Y = v => H - mB - v * (H - mT - mB);\n",
    "\n",
    "  function dibujar() {\n",
    "    const deporte = el(\"deporte\").value;\n",
    "    const p = parseFloat(el(\"p\").value);\n",
    "    const delta = deporte === \"tenis\" ? parseFloat(el(\"delta\").value) : 0;\n",
    "\n",
    "    el(\"p_val\").textContent = p.toFixed(2);\n",
    "    el(\"delta_val\").textContent = (delta >= 0 ? \"+\" : \"\") + delta.toFixed(2);\n",
    "    el(\"delta\").disabled = deporte !== \"tenis\";\n",
    "\n",
    "    // Nos quedamos con los datos del deporte y la ventaja elegidos\n",
    "    const curva = datos.filter(d => d.deporte === deporte && Math.abs(d.delta - delta) < 0.005);\n",
    "    const actual = curva.find(d => Math.abs(d.p - p) < 0.005);\n",
    "\n",
    "    el(\"texto\").innerHTML = \"Con <b>p = \" + p.toFixed(2) + \"</b>, el jugador A gana el <b>\" +\n",
    "      (actual.victorias * 100).toFixed(1) + \" %</b> de los partidos.\";\n",
    "\n",
    "    let s = \"\";\n",
    "\n",
    "    // Cuadrícula horizontal y números del eje y\n",
    "    for (let v = 0; v <= 1.0001; v += 0.2) {\n",
    "      s += '<line x1=\"' + mL + '\" x2=\"' + (W - mR) + '\" y1=\"' + Y(v) + '\" y2=\"' + Y(v) +\n",
    "           '\" stroke=\"#999\" stroke-opacity=\"0.3\"/>';\n",
    "      s += '<text x=\"' + (mL - 8) + '\" y=\"' + (Y(v) + 4) +\n",
    "           '\" text-anchor=\"end\" font-size=\"12\" fill=\"currentColor\">' + v.toFixed(1) + '</text>';\n",
    "    }\n",
    "    // Números del eje x\n",
    "    for (let i = 0; i <= 4; i++) {\n",
    "      const x = 0.40 + 0.05 * i;\n",
    "      s += '<text x=\"' + X(x) + '\" y=\"' + (H - mB + 20) +\n",
    "           '\" text-anchor=\"middle\" font-size=\"12\" fill=\"currentColor\">' + x.toFixed(2) + '</text>';\n",
    "    }\n",
    "    // Títulos de los ejes\n",
    "    s += '<text x=\"' + (mL + (W - mL - mR) / 2) + '\" y=\"' + (H - 8) +\n",
    "         '\" text-anchor=\"middle\" font-size=\"13\" fill=\"currentColor\">Probabilidad de ganar un punto (p)</text>';\n",
    "    s += '<text transform=\"rotate(-90)\" x=\"' + (-(mT + (H - mT - mB) / 2)) + '\" y=\"16\" ' +\n",
    "         'text-anchor=\"middle\" font-size=\"13\" fill=\"currentColor\">Probabilidad de ganar el partido</text>';\n",
    "\n",
    "    // Línea de referencia: un partido a un solo punto (victorias = p)\n",
    "    s += '<line x1=\"' + X(0.40) + '\" y1=\"' + Y(0.40) + '\" x2=\"' + X(0.60) + '\" y2=\"' + Y(0.60) +\n",
    "         '\" stroke=\"gray\" stroke-dasharray=\"5\"/>';\n",
    "\n",
    "    // La curva y sus puntos\n",
    "    const puntos = curva.map(d => X(d.p) + \",\" + Y(d.victorias)).join(\" \");\n",
    "    s += '<polyline points=\"' + puntos + '\" fill=\"none\" stroke=\"steelblue\" stroke-width=\"2\"/>';\n",
    "    curva.forEach(d => {\n",
    "      s += '<circle cx=\"' + X(d.p) + '\" cy=\"' + Y(d.victorias) + '\" r=\"3\" fill=\"steelblue\"/>';\n",
    "    });\n",
    "\n",
    "    // El punto elegido, en rojo\n",
    "    s += '<circle cx=\"' + X(actual.p) + '\" cy=\"' + Y(actual.victorias) + '\" r=\"8\" fill=\"red\"/>';\n",
    "\n",
    "    el(\"grafica\").innerHTML = s;\n",
    "\n",
    "    // Marcadores: una barra por cada resultado (azul = gana A, rojo = gana B)\n",
    "    const maximo = Math.max(...Object.values(actual.marcadores)) || 1;\n",
    "    let barras = \"\";\n",
    "    Object.entries(actual.marcadores).forEach(([marcador, fraccion]) => {\n",
    "      const sets = marcador.split(\"-\").map(Number);\n",
    "      const color = sets[0] > sets[1] ? \"steelblue\" : \"tomato\";\n",
    "      barras += '<div style=\"display:flex; align-items:center; gap:10px; margin:3px 0\">' +\n",
    "        '<span style=\"width:40px\"><b>' + marcador + '</b></span>' +\n",
    "        '<div style=\"flex:1; max-width:400px\">' +\n",
    "          '<div style=\"background:' + color + '; height:16px; width:' + (fraccion / maximo * 100) + '%\"></div>' +\n",
    "        '</div>' +\n",
    "        '<span style=\"width:60px; text-align:right\">' + (fraccion * 100).toFixed(1) + ' %</span>' +\n",
    "      '</div>';\n",
    "    });\n",
    "    el(\"marcadores\").innerHTML = barras;\n",
    "  }\n",
    "\n",
    "  // Cada vez que el usuario toca un control, se vuelve a dibujar\n",
    "  [\"deporte\", \"p\", \"delta\"].forEach(id => el(id).addEventListener(\"input\", dibujar));\n",
    "  dibujar();\n",
    "})();\n",
    "</script>\n",
    "\"\"\"\n",
    "\n",
    "display(HTML(PLANTILLA.replace(\"__DATOS__\", json.dumps(filas))))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1a31187c",
   "metadata": {},
   "source": [
    "*La línea discontinua gris es la referencia de un partido a un solo punto: ahí la\n",
    "probabilidad de ganar sería igual a 'p'.*"
   ]
  }
 ],
